# ═══════════════════════════════════════
#  LAPTOP 2 — .env
#  cp .env.example .env lalu isi IP_LAPTOP3
# ═══════════════════════════════════════

# ── WAJIB DIISI — IP laptop 3 di jaringan lokal ──────
# Cek IP laptop 3 dengan: ipconfig (Windows) atau ip a (Linux)
# Harus IP yang sama dengan yang diisi di laptop 1
LAPTOP3_IP=192.168.1.10

# ── MinIO credentials (harus sama dengan laptop 3) ───
MINIO_ROOT_USER=seismic_admin
MINIO_ROOT_PASSWORD=seismic_secret_2024

# ── PostgreSQL credentials (harus sama dengan laptop 3)
POSTGRES_DB=seismic_db
POSTGRES_USER=seismic_user
POSTGRES_PASSWORD=seismic_pass_2024
